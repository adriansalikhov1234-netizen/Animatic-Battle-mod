  "entrypoints": {
    "client": ["com.example.totemimpact.TotemImpactClient"]
  },
  "mixins": [
    { "config": "totemimpact.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
